#!/bin/bash
set -e

# Depo - Self-hosted remote Docker build system
# Usage: depo <command> [options]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${SCRIPT_DIR}/.env"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Load environment variables
load_env() {
    if [[ -f "$ENV_FILE" ]]; then
        log_info "Loading environment from ${ENV_FILE}"
        set -a
        source "$ENV_FILE"
        set +a
    fi

    # Required variables with fallbacks to existing ENV
    : "${AWS_ACCESS_KEY_ID:?AWS_ACCESS_KEY_ID is required}"
    : "${AWS_SECRET_ACCESS_KEY:?AWS_SECRET_ACCESS_KEY is required}"
    : "${AWS_REGION:=us-east-1}"
    : "${DOCKERHUB_USER:?DOCKERHUB_USER is required}"
    : "${DOCKERHUB_PASSWORD:?DOCKERHUB_PASSWORD is required}"
    : "${DEPO_KEY_PAIR_NAME:=depo-builder}"
    : "${DEPO_SECURITY_GROUP_NAME:=depo-builder-sg}"
    : "${DEPO_INSTANCE_TYPE_X86:=t3.medium}"
    : "${DEPO_INSTANCE_TYPE_ARM:=t4g.medium}"
    : "${DEPO_ECR_REPO_NAME:=depo-cache}"
    # Spot instances: DEPO_USE_SPOT=true enables spot, DEPO_SPOT_MAX_PRICE is optional
    : "${DEPO_USE_SPOT:=}"
    : "${DEPO_SPOT_MAX_PRICE:=}"

    export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION
    export DOCKERHUB_USER DOCKERHUB_PASSWORD
    export DEPO_KEY_PAIR_NAME DEPO_SECURITY_GROUP_NAME
    export DEPO_INSTANCE_TYPE_X86 DEPO_INSTANCE_TYPE_ARM
    export DEPO_ECR_REPO_NAME
    export DEPO_USE_SPOT DEPO_SPOT_MAX_PRICE
}

# Show help
show_help() {
    cat << EOF
Depo - Self-hosted Remote Docker Build System

Usage: depo <command> [options]

Commands:
    build       Run a remote Docker build
    manage      Manage infrastructure (AMIs, ECR cache)
    help        Show this help message

Build Usage:
    depo build [docker build options]
    
    The build command accepts all standard docker build arguments.
    Use --arch to specify architecture (x86_64 or arm64, default: x86_64)
    
    Example:
        depo build -t myimage:latest . --push --platform=linux/amd64
        depo build --arch=arm64 -t myimage:arm64 . --push

Manage Usage:
    depo manage <subcommand> [options]

    Subcommands:
        ami create      Create/update Packer AMIs
        ami delete      Delete Packer AMIs
        status          Show current infrastructure status

    Options:
        --arch=x86_64|arm64|all    Target architecture (default: all)

    Examples:
        depo manage ami create                 # Create both x86 and arm AMIs
        depo manage ami create --arch=x86_64   # Create only x86 AMI
        depo manage status                     # Show infrastructure status

Environment Variables (set in .env or export):
    AWS_ACCESS_KEY_ID       AWS access key
    AWS_SECRET_ACCESS_KEY   AWS secret key
    AWS_REGION              AWS region (default: us-east-1)
    DOCKERHUB_USER          Docker Hub username
    DOCKERHUB_PASSWORD      Docker Hub password/token
    DEPO_KEY_PAIR_NAME      EC2 key pair name (default: depo-builder)
    DEPO_INSTANCE_TYPE_X86  Instance type for x86 builds (default: t3.medium)
    DEPO_INSTANCE_TYPE_ARM  Instance type for arm builds (default: t4g.medium)
    DEPO_ECR_REPO_NAME      ECR repository for build cache (default: depo-cache)
    DEPO_USE_SPOT           Set to 'true' to use spot instances (default: off)
    DEPO_SPOT_MAX_PRICE     Max hourly price for spot (optional, defaults to on-demand price)
EOF
}

# Get AMI ID by architecture
get_ami_id() {
    local arch=$1
    aws ec2 describe-images \
        --owners self \
        --filters "Name=name,Values=depo-builder-${arch}-*" \
        --query 'Images | sort_by(@, &CreationDate) | [-1].ImageId' \
        --output text 2>/dev/null || echo "None"
}

# Get ECR repository URI
get_ecr_repo_uri() {
    aws ecr describe-repositories \
        --repository-names "$DEPO_ECR_REPO_NAME" \
        --query 'repositories[0].repositoryUri' \
        --output text 2>/dev/null || echo "None"
}

# Show infrastructure status
show_status() {
    load_env
    log_info "Checking infrastructure status in ${AWS_REGION}..."

    echo ""
    echo "=== AMIs ==="
    for arch in x86_64 arm64; do
        ami_id=$(get_ami_id "$arch")
        if [[ "$ami_id" != "None" && -n "$ami_id" ]]; then
            echo -e "  ${arch}: ${GREEN}${ami_id}${NC}"
        else
            echo -e "  ${arch}: ${RED}Not found${NC}"
        fi
    done

    echo ""
    echo "=== ECR Cache Repository ==="
    ecr_uri=$(get_ecr_repo_uri)
    if [[ "$ecr_uri" != "None" && -n "$ecr_uri" ]]; then
        echo -e "  ${DEPO_ECR_REPO_NAME}: ${GREEN}${ecr_uri}${NC}"
    else
        echo -e "  ${DEPO_ECR_REPO_NAME}: ${RED}Not found${NC}"
    fi

    echo ""
    echo "=== Key Pair ==="
    key_exists=$(aws ec2 describe-key-pairs --key-names "$DEPO_KEY_PAIR_NAME" --query 'KeyPairs[0].KeyName' --output text 2>/dev/null || echo "None")
    if [[ "$key_exists" != "None" && -n "$key_exists" ]]; then
        echo -e "  ${DEPO_KEY_PAIR_NAME}: ${GREEN}exists${NC}"
    else
        echo -e "  ${DEPO_KEY_PAIR_NAME}: ${RED}not found${NC}"
    fi

    echo ""
    echo "=== Security Group ==="
    sg_id=$(aws ec2 describe-security-groups --group-names "$DEPO_SECURITY_GROUP_NAME" --query 'SecurityGroups[0].GroupId' --output text 2>/dev/null || echo "None")
    if [[ "$sg_id" != "None" && -n "$sg_id" ]]; then
        echo -e "  ${DEPO_SECURITY_GROUP_NAME}: ${GREEN}${sg_id}${NC}"
    else
        echo -e "  ${DEPO_SECURITY_GROUP_NAME}: ${RED}not found${NC}"
    fi
}

# Create AMI using Packer
create_ami() {
    local arch=$1
    load_env
    
    log_info "Creating AMI for ${arch}..."
    
    cd "${SCRIPT_DIR}/packer"
    
    packer init .
    packer build \
        -on-error=ask \
        -var "aws_region=${AWS_REGION}" \
        -var "architecture=${arch}" \
        -only="amazon-ebs.depo-builder-${arch}" \
        .
    
    log_success "AMI created for ${arch}"
}

# Delete AMI
delete_ami() {
    local arch=$1
    load_env
    
    ami_id=$(get_ami_id "$arch")
    if [[ "$ami_id" == "None" || -z "$ami_id" ]]; then
        log_warn "No AMI found for ${arch}"
        return 0
    fi
    
    log_info "Deleting AMI ${ami_id} for ${arch}..."
    
    # Get snapshot IDs associated with the AMI
    snapshot_ids=$(aws ec2 describe-images --image-ids "$ami_id" \
        --query 'Images[0].BlockDeviceMappings[*].Ebs.SnapshotId' --output text)
    
    # Deregister AMI
    aws ec2 deregister-image --image-id "$ami_id"
    
    # Delete associated snapshots
    for snap_id in $snapshot_ids; do
        if [[ -n "$snap_id" && "$snap_id" != "None" ]]; then
            log_info "Deleting snapshot ${snap_id}..."
            aws ec2 delete-snapshot --snapshot-id "$snap_id"
        fi
    done
    
    log_success "AMI deleted for ${arch}"
}

# Run command for both architectures concurrently or single arch
run_for_arch() {
    local func=$1
    local arch=$2
    
    if [[ "$arch" == "all" ]]; then
        log_info "Running for both architectures concurrently..."
        $func "x86_64" &
        local pid1=$!
        $func "arm64" &
        local pid2=$!
        
        wait $pid1
        local status1=$?
        wait $pid2
        local status2=$?
        
        if [[ $status1 -ne 0 || $status2 -ne 0 ]]; then
            log_error "One or more operations failed"
            return 1
        fi
    else
        $func "$arch"
    fi
}

# Handle manage command
handle_manage() {
    local subcommand=$1
    shift
    
    local arch="all"
    
    # Parse options
    while [[ $# -gt 0 ]]; do
        case $1 in
            --arch=*)
                arch="${1#*=}"
                ;;
            *)
                log_error "Unknown option: $1"
                exit 1
                ;;
        esac
        shift
    done
    
    # Validate arch
    if [[ "$arch" != "all" && "$arch" != "x86_64" && "$arch" != "arm64" ]]; then
        log_error "Invalid architecture: ${arch}. Must be x86_64, arm64, or all"
        exit 1
    fi
    
    case $subcommand in
        "ami create")
            run_for_arch create_ami "$arch"
            ;;
        "ami delete")
            run_for_arch delete_ami "$arch"
            ;;
        "status")
            show_status
            ;;
        *)
            log_error "Unknown manage subcommand: ${subcommand}"
            show_help
            exit 1
            ;;
    esac
}

# Handle build command
handle_build() {
    load_env

    # Generate unique build ID for concurrent builds
    local build_id=$(uuidgen | cut -c1-8)
    local state_file="${SCRIPT_DIR}/terraform/terraform-${build_id}.tfstate"

    # Cleanup function for interrupted builds
    cleanup_build() {
        if [[ -f "$state_file" ]]; then
            log_warn "Build interrupted, cleaning up..."
            cd "${SCRIPT_DIR}/terraform"
            terraform destroy -auto-approve -state="$state_file" \
                -var "aws_region=${AWS_REGION:-us-east-1}" \
                -var "ami_id=${ami_id:-ami-placeholder}" \
                -var "instance_type=${instance_type:-t3.medium}" \
                -var "key_pair_name=${DEPO_KEY_PAIR_NAME:-depo-builder}" \
                -var "security_group_name=${DEPO_SECURITY_GROUP_NAME:-depo-builder-sg}" \
                -var "use_spot=${use_spot:-false}" \
                -var "spot_max_price=${DEPO_SPOT_MAX_PRICE:-}" 2>/dev/null || true
            rm -f "$state_file" "${state_file}.backup"
        fi
        [[ -n "$context_tar" && -f "$context_tar" ]] && rm -f "$context_tar"
    }
    trap cleanup_build EXIT

    local arch=""
    local platform=""
    local docker_args=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --arch=*)
                arch="${1#*=}"
                ;;
            --platform=*)
                platform="${1#*=}"
                docker_args+=("$1")
                ;;
            *)
                docker_args+=("$1")
                ;;
        esac
        shift
    done

    # If arch not explicitly set, infer from --platform
    if [[ -z "$arch" ]]; then
        case "$platform" in
            linux/arm64|linux/arm64/*)
                arch="arm64"
                ;;
            *)
                arch="x86_64"
                ;;
        esac
    fi

    # Validate arch
    if [[ "$arch" != "x86_64" && "$arch" != "arm64" ]]; then
        log_error "Invalid architecture: ${arch}. Must be x86_64 or arm64"
        exit 1
    fi

    # Check prerequisites
    ami_id=$(get_ami_id "$arch")
    if [[ "$ami_id" == "None" || -z "$ami_id" ]]; then
        log_error "No AMI found for ${arch}. Run 'depo manage ami create --arch=${arch}' first."
        exit 1
    fi

    ecr_repo_uri=$(get_ecr_repo_uri)
    if [[ "$ecr_repo_uri" == "None" || -z "$ecr_repo_uri" ]]; then
        log_error "ECR cache repository not found. Run './scripts/setup.sh' first."
        exit 1
    fi

    # Derive cache reference from build context directory name
    local build_context_dir="."
    for arg in "${docker_args[@]}"; do
        if [[ ! "$arg" =~ ^- && -d "$arg" ]]; then
            build_context_dir="$arg"
        fi
    done
    local project_name=$(basename "$(cd "$build_context_dir" && pwd)")
    local cache_ref="${ecr_repo_uri}:${project_name}"

    log_info "Starting build for ${arch}..."
    log_info "AMI: ${ami_id}"
    log_info "Cache: ${cache_ref}"
    log_info "Docker command: docker buildx build ${docker_args[*]}"

    # Create build context tarball
    local context_tar="/tmp/depo-context-$$.tar.gz"

    log_info "Creating build context tarball from ${build_context_dir}..."

    # Create tarball respecting .dockerignore
    if [[ -f "${build_context_dir}/.dockerignore" ]]; then
        tar -czf "$context_tar" -C "$build_context_dir" \
            --exclude-from="${build_context_dir}/.dockerignore" \
            --exclude='.git' \
            .
    else
        tar -czf "$context_tar" -C "$build_context_dir" \
            --exclude='.git' \
            .
    fi

    local context_size=$(du -h "$context_tar" | cut -f1)
    log_info "Build context size: ${context_size}"

    # Run Terraform to deploy build server
    cd "${SCRIPT_DIR}/terraform"

    # Determine instance type
    if [[ "$arch" == "x86_64" ]]; then
        instance_type="$DEPO_INSTANCE_TYPE_X86"
    else
        instance_type="$DEPO_INSTANCE_TYPE_ARM"
    fi

    # Determine if using spot instances
    local use_spot="false"
    if [[ "${DEPO_USE_SPOT}" == "true" || "${DEPO_USE_SPOT}" == "1" ]]; then
        use_spot="true"
        log_info "Using spot instances"
        if [[ -n "${DEPO_SPOT_MAX_PRICE}" ]]; then
            log_info "Spot max price: \$${DEPO_SPOT_MAX_PRICE}/hour"
        fi
    fi

    log_info "Deploying build server..."

    terraform init -input=false > /dev/null

    terraform apply -auto-approve -state="$state_file" \
        -var "aws_region=${AWS_REGION}" \
        -var "ami_id=${ami_id}" \
        -var "instance_type=${instance_type}" \
        -var "key_pair_name=${DEPO_KEY_PAIR_NAME}" \
        -var "security_group_name=${DEPO_SECURITY_GROUP_NAME}" \
        -var "use_spot=${use_spot}" \
        -var "spot_max_price=${DEPO_SPOT_MAX_PRICE}"

    # Get instance details
    instance_ip=$(terraform output -state="$state_file" -raw instance_public_ip)
    instance_id=$(terraform output -state="$state_file" -raw instance_id)

    log_info "Build server deployed: ${instance_id} (${instance_ip})"

    # Wait for SSH to be available
    log_info "Waiting for SSH to be available..."
    local max_attempts=30
    local attempt=0
    while ! ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o BatchMode=yes \
        -i "${SCRIPT_DIR}/${DEPO_KEY_PAIR_NAME}.pem" \
        ec2-user@"$instance_ip" "echo ready" &>/dev/null; do
        attempt=$((attempt + 1))
        if [[ $attempt -ge $max_attempts ]]; then
            log_error "Timeout waiting for SSH"
            terraform destroy -auto-approve -state="$state_file" \
                -var "aws_region=${AWS_REGION}" \
                -var "ami_id=${ami_id}" \
                -var "instance_type=${instance_type}" \
                -var "key_pair_name=${DEPO_KEY_PAIR_NAME}" \
                -var "security_group_name=${DEPO_SECURITY_GROUP_NAME}" \
                -var "use_spot=${use_spot}" \
                -var "spot_max_price=${DEPO_SPOT_MAX_PRICE}"
            rm -f "$state_file" "${state_file}.backup" "$context_tar"
            trap - EXIT
            exit 1
        fi
        sleep 5
    done

    log_success "SSH connection established"

    # Transfer build context
    log_info "Transferring build context..."
    scp -o StrictHostKeyChecking=no \
        -i "${SCRIPT_DIR}/${DEPO_KEY_PAIR_NAME}.pem" \
        "$context_tar" \
        ec2-user@"$instance_ip":/tmp/build-context.tar.gz

    # Get AWS account ID for ECR login
    local aws_account_id=$(aws sts get-caller-identity --query Account --output text)
    local ecr_registry="${aws_account_id}.dkr.ecr.${AWS_REGION}.amazonaws.com"

    # Run the build
    log_info "Running Docker build..."

    # Construct remote commands
    local remote_script=$(cat << REMOTE_EOF
set -e

# Extract build context
echo "Extracting build context..."
if [ -d /home/ec2-user/build ]; then
  rm -rf /home/ec2-user/build
fi
mkdir -p /home/ec2-user/build
cd /home/ec2-user/build
tar -xzf /tmp/build-context.tar.gz

# Wait for Docker to be ready
while ! docker info &>/dev/null; do
    echo "Waiting for Docker..."
    sleep 2
done

# Login to ECR for cache
echo "Logging into ECR..."
aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ecr_registry}

# Login to Docker Hub for push
echo "Logging into Docker Hub..."
echo '${DOCKERHUB_PASSWORD}' | docker login -u '${DOCKERHUB_USER}' --password-stdin

# Run the build with buildx and ECR cache
docker buildx create --name depo-builder --driver docker-container --use
echo "Starting Docker build..."
docker buildx build \
    --cache-from type=registry,ref=${cache_ref} \
    --cache-to type=registry,ref=${cache_ref},oci-mediatypes=true,mode=max \
    ${docker_args[@]}

echo "Build completed successfully!"
REMOTE_EOF
)
    ssh -tt -o StrictHostKeyChecking=no \
        -i "${SCRIPT_DIR}/${DEPO_KEY_PAIR_NAME}.pem" \
        ec2-user@"$instance_ip" "$remote_script"

    local build_status=$?

    # Cleanup
    log_info "Cleaning up..."
    rm -f "$context_tar"

    # Destroy the instance
    log_info "Destroying build server..."
    terraform destroy -auto-approve -state="$state_file" \
        -var "aws_region=${AWS_REGION}" \
        -var "ami_id=${ami_id}" \
        -var "instance_type=${instance_type}" \
        -var "key_pair_name=${DEPO_KEY_PAIR_NAME}" \
        -var "security_group_name=${DEPO_SECURITY_GROUP_NAME}" \
        -var "use_spot=${use_spot}" \
        -var "spot_max_price=${DEPO_SPOT_MAX_PRICE}"

    # Clean up state file after successful destroy
    rm -f "$state_file" "${state_file}.backup"
    trap - EXIT

    if [[ $build_status -eq 0 ]]; then
        log_success "Build completed successfully!"
    else
        log_error "Build failed with status ${build_status}"
        exit $build_status
    fi
}

# Main entry point
main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi
    
    local command=$1
    shift
    
    case $command in
        build)
            handle_build "$@"
            ;;
        manage)
            # Combine first two args for subcommand (e.g., "ami create")
            if [[ $# -ge 2 ]]; then
                local subcmd="$1 $2"
                shift 2
                handle_manage "$subcmd" "$@"
            elif [[ $# -eq 1 && "$1" == "status" ]]; then
                handle_manage "status"
            else
                log_error "Invalid manage command"
                show_help
                exit 1
            fi
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "Unknown command: ${command}"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
