# Depo Configuration
# Copy this file to .env and fill in your values

# AWS Credentials (required)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# Docker Hub Credentials (required)
DOCKERHUB_USER=your_dockerhub_username
DOCKERHUB_PASSWORD=your_dockerhub_password_or_token

# Optional Configuration
# DEPO_KEY_PAIR_NAME=depo-builder
# DEPO_SECURITY_GROUP_NAME=depo-builder-sg
# DEPO_INSTANCE_TYPE_X86=t3.medium
# DEPO_INSTANCE_TYPE_ARM=t4g.medium
# DEPO_CACHE_VOLUME_SIZE=50
